# ===========================================================================
# rag_config.txt 示例文件
#   1. 复制为 rag_config.txt：copy rag_config.txt.example rag_config.txt
#   2. 填入真实值
#   3. rag_config.txt 已被 .gitignore / .dockerignore 忽略，不会泄露
#
# 本地直接跑（python -m streamlit run app.py）时读这个文件；
# 用 docker compose 跑时，docker-compose.yml 会把同名环境变量注入容器，
# 环境变量优先级高于本文件，两者写一致即可。
# ===========================================================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=you_mysql_password_here
MYSQL_DB=rag_app

ZHIPU_API_KEY=your_zhipu_api_key_here
OPENAI_API_BASE=https://open.bigmodel.cn/api/paas/v4/

ES_HOST=localhost
ES_PORT=9200

REDIS_HOST=localhost
REDIS_PORT=6379

# 向量库根目录，留空 = 用项目根目录
# CHROMA_BASE_DIR=

# ---------- 上传原件留存（文件管理 + 下载）----------
# 上传时把原件留一份到 <FILE_STORE_DIR>/<file_uuid><ext>，下载接口据此找回。
# 留空 = <项目根目录>/file_store（已 gitignore；Docker 里建议挂到持久化卷）
# FILE_STORE_DIR=
# 历史原件兜底目录（逗号分隔，留空 = 项目根目录）。
# 改造前入库的文件没有留存件，按**文件名精确匹配**去这些目录里找
# （本机交付环境的原件就放在项目根目录）。
# FILE_LEGACY_SEARCH_DIRS=

