# ===========================================================================
# 复制本文件为 .env（或 rag_config.txt），填入真实值后再启动服务。
# 千万不要把 .env / rag_config.txt 提交到 Git，也不要把密钥写进 docker-compose.yml。
# .env 会被 docker compose 自动读取，用于替换 docker-compose.yml 里的 ${XXX} 变量。
# ===========================================================================

# ---------- MySQL ----------
# ⚠️ 用 docker compose 起全套时，应用是拿 root 账号连库的，
#    所以下面两个密码要填**同一个值**；MYSQL_PASSWORD 是应用侧用的，MYSQL_ROOT_PASSWORD 是 MySQL 容器初始化用的。
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=you_mysql_password_here
MYSQL_ROOT_PASSWORD=you_mysql_password_here
MYSQL_DB=rag_app

# ---------- 大模型（智谱 GLM，OpenAI 兼容协议）----------
ZHIPU_API_KEY=your_zhipu_api_key_here
OPENAI_API_BASE=https://open.bigmodel.cn/api/paas/v4/

# ---------- Elasticsearch ----------
ES_HOST=localhost
ES_PORT=9200

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379

# ---------- 其他 ----------
# HuggingFace 镜像（国内下载 cross-encoder 模型用）
HF_ENDPOINT=https://hf-mirror.com
# 向量库根目录，留空则使用项目根目录（Docker 里建议设成 /app/chroma_store）
# CHROMA_BASE_DIR=
